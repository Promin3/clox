print "=== Arithmetic ===";
print 1 + 2;
print 5 - 3;
print 4 * 3;
print 10 / 2;
print -(3 + 2);

print "=== Comparison ===";
print 3 > 2;
print 3 < 5;
print 3 >= 3;
print 5 <= 3;
print 3 == 3;
print 3 != 4;

print "=== Boolean & Nil ===";
print true;
print false;
print nil;
print !true;
print !false;
print !!true;

print "=== Variables ===";
var a = 10;
var b = 20;
print a + b;
a = 42;
print a;
var name = "clox";
print name;

print "=== Strings ===";
print "hello" + " world";
print "hello" == "hello";
print "hello" != "world";

print "=== Mixed ===";
var x = (1 + 2) * 3;
print x;
print 2 * 3 + 4 > 5;
print "count: " + "1";
